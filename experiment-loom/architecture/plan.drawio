<mxfile host="straymark" type="device">
  <diagram name="Architecture" id="straymark-architecture">
    <mxGraphModel dx="1024" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object label="straymark-cli" straymark_component_id="cli" id="comp-cli">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="200" height="60" as="geometry" />
          </mxCell>
        </object>
        <object label="straymark-core" straymark_component_id="core" id="comp-core">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="320" y="40" width="200" height="60" as="geometry" />
          </mxCell>
        </object>
        <object label="Loom (experimental dashboard)" straymark_component_id="experiment-loom" id="comp-experiment-loom">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="200" width="200" height="60" as="geometry" />
          </mxCell>
        </object>
        <object label="Website (straymark.dev)" straymark_component_id="website" id="comp-website">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="360" width="200" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-cli-core" style="endArrow=block;html=1;" edge="1" parent="1" source="comp-cli" target="comp-core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-experiment-loom-core" style="endArrow=block;html=1;" edge="1" parent="1" source="comp-experiment-loom" target="comp-core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
