/.claude/
/.gemini/
/.agent/
/.cursorrules
/.cursor/

# =============================================================================
# Desarrollo interno de Strange Days Tech
# =============================================================================

copy-to-all-lnxdrive.sh
Aparador/


# =============================================================================
# Operating System Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# =============================================================================
# Editor and IDE Files
# =============================================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# =============================================================================
# Node.js (for markdownlint and other tools)
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Website and Loom lockfiles must be committed — CI uses `npm ci` for reproducible builds.
!website/package-lock.json
!experiment-loom/web/package-lock.json

# =============================================================================
# Temporary Files
# =============================================================================

*.tmp
*.temp
*.log
*.bak

# =============================================================================
# DevTrail Framework Specific
# =============================================================================

# Temporary validation files
.markdownlint.json

# =============================================================================
# CLI Build Artifacts
# =============================================================================

/target/
cli/target/
dist-staging/
*.tar.gz
release/

# =============================================================================
# Security - Never commit these
# =============================================================================

# Environment files
.env
.env.local
.env.*.local
*.env

# Credentials
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx

# API keys
api_keys.txt
api_keys.json
nul

# =============================================================================
# Loom (experiment-loom/) — JS confined to web/, built only in CI
# =============================================================================

experiment-loom/web/node_modules/
experiment-loom/web/dist/

# StrayMark self-adoption (S5, AIDEC-2026-07-13-001): framework files are
# regenerable from the pinned release (straymark update-framework); do not
# version them. Only the produced governance artifacts + the pin record
# (config.yml, .provenance.yml, .checksums.json, dist-manifest.yml, 07-ai-audit/,
# charters/, numbered dirs) are versioned.
/.claude/skills/
/.gemini/skills/
/.codex/skills/
/.qoder/skills/
/.agent/workflows/
/STRAYMARK.md
/.straymark/00-governance/
/.straymark/templates/
/.straymark/schemas/
/.straymark/audit-prompts/
/.straymark/hooks/
/.straymark/QUICK-REFERENCE.md
# runtime-specific directives we don't use (StrayMark dev = Claude Code):
/GEMINI.md
/.cursorrules
/.cursor/
/.github/copilot-instructions.md
/.github/workflows/docs-validation.yml
# framework reference material shipped into numbered dirs / scripts (regenerable):
/.straymark/scripts/
/.straymark/03-implementation/NIST-*.md
/.straymark/03-implementation/i18n/

